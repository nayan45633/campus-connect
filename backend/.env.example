# ==============================================================================
# Campus Connect Backend - Environment Configuration Example
# Copy this file to .env and adjust the variables for your local setup.
# Never commit the actual .env file to version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="Campus Connect API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & JWT Authentication
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="generate_and_replace_with_a_secure_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (JSON array of strings)
# Includes local Vite dev server ports
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="campus_connect_db"

# Database Connection URL (uses modern psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+psycopg://postgres:your_postgres_password@localhost:5432/campus_connect_db"

# Database Pool & Health Check Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5
